{
  "name": "ideas",
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev:back": "tsx watch src/backend/main.ts",
    "dev:front": "vite src/frontend --config ./vite.config.ts",
    "dev": "npm run dev:back & npm run dev:front",
    "build:front": "vite build src/frontend --emptyOutDir --config ./vite.config.ts",
    "build:back": "tsc --build",
    "build": "npm run build:back && npm run build:front",
    "seed": "node scripts/seed.js",
    "setup": "node scripts/setup.js"
  },
  "dependencies": {
    "config": "^4.1.1",
    "express": "^5.1.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "request-ip": "^3.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "lorem-ipsum": "^2.0.8",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
